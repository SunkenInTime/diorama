            { "row_grid@diorama.diorama_row": { "offset": [0, 330], "controls": [{ "row_label@diorama.text_dim": { "text": "\u533a\u5757\u7f51\u683c", "offset": [4, 0], "anchor_from": "left_middle", "anchor_to": "left_middle" } }, { "toggle@diorama.diorama_button": { "size": [30, 18], "anchor_from": "right_middle", "anchor_to": "right_middle" } }] } },
