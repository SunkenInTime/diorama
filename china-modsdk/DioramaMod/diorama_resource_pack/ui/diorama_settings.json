{
  "namespace": "diorama",

  "main@common.base_screen": {
    "$screen_content": "diorama.settings_root",
    "absorbs_input": true,
    "force_render_below": false,
    "is_showing_menu": true,
    "render_game_behind": true,
    "render_only_when_topmost": true,
    "should_steal_mouse": false
  },

  "settings_root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "backdrop@diorama.panel_solid": { "alpha": 0.9 } },
      { "title_label@diorama.text_gold": { "text": "Diorama \u00b7 \u8bbe\u7f6e", "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 6] } },

      { "rows": {
          "type": "panel",
          "size": ["76%", "74%"],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0, -6],
          "controls": [
            { "row_minimap@diorama.diorama_row": { "offset": [0, 0], "controls": [{ "row_label@diorama.text_dim": { "text": "\u8ff7\u4f60\u5730\u56fe", "offset": [4, 0], "anchor_from": "left_middle", "anchor_to": "left_middle" } }, { "toggle@diorama.diorama_button": { "size": [30, 18], "anchor_from": "right_middle", "anchor_to": "right_middle" } }] } },
            { "row_compass@diorama.diorama_row": { "offset": [0, 22], "controls": [{ "row_label@diorama.text_dim": { "text": "\u6307\u5357\u9488", "offset": [4, 0], "anchor_from": "left_middle", "anchor_to": "left_middle" } }, { "toggle@diorama.diorama_button": { "size": [30, 18], "anchor_from": "right_middle", "anchor_to": "right_middle" } }] } },
            { "row_coordinates@diorama.diorama_row": { "offset": [0, 44], "controls": [{ "row_label@diorama.text_dim": { "text": "\u5750\u6807", "offset": [4, 0], "anchor_from": "left_middle", "anchor_to": "left_middle" } }, { "toggle@diorama.diorama_button": { "size": [30, 18], "anchor_from": "right_middle", "anchor_to": "right_middle" } }] } },
            { "row_biome@diorama.diorama_row": { "offset": [0, 66], "controls": [{ "row_label@diorama.text_dim": { "text": "\u751f\u7269\u7fa4\u7cfb", "offset": [4, 0], "anchor_from": "left_middle", "anchor_to": "left_middle" } }, { "toggle@diorama.diorama_button": { "size": [30, 18], "anchor_from": "right_middle", "anchor_to": "right_middle" } }] } },
