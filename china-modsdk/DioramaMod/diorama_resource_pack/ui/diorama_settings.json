      { "summary_label@diorama.text_dim": { "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "offset": [0, -34] } },

      { "button_row": {
          "type": "panel",
          "size": ["40%", 24],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, -8],
          "controls": [
            { "reset_button@diorama.diorama_button": { "size": [80, 22], "offset": [0, 0], "controls": [{ "label@diorama.button_label": { "text": "\u6062\u590d\u9ed8\u8ba4" } }] } },
            { "done_button@diorama.diorama_button": { "size": [80, 22], "offset": [90, 0], "controls": [{ "label@diorama.button_label": { "text": "\u5b8c\u6210" } }] } }
          ]
        }
      }
