    <license>
      <name>MIT License</name>
      <url>https://github.com/SunkenInTime/diorama/blob/master/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/SunkenInTime/diorama.git</connection>
    <developerConnection>scm:git:git@github.com:SunkenInTime/diorama.git</developerConnection>
    <url>https://github.com/SunkenInTime/diorama</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/SunkenInTime/diorama/issues</url>
  </issueManagement>
</project>
